<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dareu.LM113.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="840" d:DesignHeight="650"
        x:Class="Dareu.LM113.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="avares://Dareu.LM113.App/Assets/app.ico"
        Title="达尔优 LM113 发光鼠标 跨平台驱动客户端"
        Width="840" Height="650"
        WindowStartupLocation="CenterScreen"
        CanResize="false"
        Background="{StaticResource BrushBgDeep}">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- 顶部品牌与状态 Header -->
        <Border Grid.Row="0" Background="#181822" Padding="20,14" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <!-- 左侧设备与连接状态 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Image Source="avares://Dareu.LM113.App/Assets/logo.png" Width="26" Height="26" VerticalAlignment="Center" />
                    <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center">
                        <Border.Styles>
                            <Style Selector="Border">
                                <Setter Property="Background" Value="#F44336" />
                            </Style>
                            <Style Selector="Border.connected">
                                <Setter Property="Background" Value="#00F5A0" />
                                <Setter Property="BoxShadow" Value="0 0 8 0 #8000F5A0" />
                            </Style>
                        </Border.Styles>
                        <Classes.connected>
                            <Binding Path="IsConnected" />
                        </Classes.connected>
                    </Border>
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="DAREU LM113" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                        <TextBlock Text="{Binding DeviceInfoText}" Classes="mono" FontSize="11" Foreground="#8E8EA0" />
                    </StackPanel>
                </StackPanel>

                <!-- 右侧快捷功能胶囊按钮 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Classes="sub-action" Content="扫描连接" Command="{Binding AutoConnectCommand}" />
                    <Button Classes="sub-action" Content="导入 p1.bin" Command="{Binding ImportOriginalP1Command}" />
                    <Button Classes="danger-action" Content="恢复出厂" Command="{Binding FactoryResetCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主体控制中心卡片 (方案 B：分段药丸导航 + 视觉树常驻 0 延迟秒切) -->
        <Border Grid.Row="1" Margin="20,16" Classes="card" Padding="18">
            <Grid RowDefinitions="Auto,*">
                <!-- 顶部 Segmented 药丸导航栏 (点击即刻响应，无销毁卡顿) -->
                <Border Grid.Row="0" Background="#161620" CornerRadius="8" Padding="4" HorizontalAlignment="Left" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Classes="nav-pill" Classes.active="{Binding IsDpiTabActive}" Content="⚡ DPI 灵敏度" Command="{Binding SwitchTabCommand}" CommandParameter="0" />
                        <Button Classes="nav-pill" Classes.active="{Binding IsRgbTabActive}" Content="🌈 RGB 幻彩灯光" Command="{Binding SwitchTabCommand}" CommandParameter="1" />
                        <Button Classes="nav-pill" Classes.active="{Binding IsAboutTabActive}" Content="⚙️ 系统与关于" Command="{Binding SwitchTabCommand}" CommandParameter="2" />
                    </StackPanel>
                </Border>

                <!-- 异步加载转圈圈视图 (当 IsLoadingTab 为 True 时即时显示) -->
                <Border Grid.Row="1" IsVisible="{Binding IsLoadingTab}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80">
                    <StackPanel Spacing="16" HorizontalAlignment="Center">
                        <!-- 电竞霓虹转动进度条 -->
                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" CornerRadius="2"
                                     Foreground="{StaticResource BrushPurpleGreenGradient}" 
                                     Background="#252536" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="14" Foreground="#00F5A0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding LoadingTitle}" Classes="mono" FontSize="13" Foreground="#B0B0C4" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 主体内容容器 (当 !IsLoadingTab 时呈现) -->
                <Grid Grid.Row="1" IsVisible="{Binding !IsLoadingTab}">
                    <!-- ==================== DPI 灵敏度页面 ==================== -->
                    <ScrollViewer IsVisible="{Binding IsDpiTabActive}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="4,4,4,4">
                            <!-- 标题与副标题 -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3">
                                    <TextBlock Text="6 档 DPI 曲线调节" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />
                                    <TextBlock Text="勾选启用档位，拖动滑块即可精细微调各档 DPI（200 ~ 6400）" FontSize="12" Foreground="#8E8EA0" />
                                </StackPanel>
                            </Grid>

                            <!-- DPI 6 档自定义卡片列表 -->
                            <ItemsControl ItemsSource="{Binding DpiStages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:DpiStageItemViewModel">
                                        <Border Background="#161620" CornerRadius="8" Padding="14,10" Margin="0,4" BorderBrush="#252536" BorderThickness="1">
                                            <Grid ColumnDefinitions="90,110,*,44">
                                                <!-- 档位启用勾选 -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled}" Content="{Binding StageLabel}" FontWeight="SemiBold" FontSize="13" />
                                                <!-- DPI 数值展示 (等宽硬核字体) -->
                                                <TextBlock Grid.Column="1" Text="{Binding DpiText}" Classes="mono" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#00F5A0" />
                                                <!-- DPI 滑块 -->
                                                <Slider Grid.Column="2" Minimum="200" Maximum="6400" Value="{Binding Dpi}" TickFrequency="100" IsSnapToTickEnabled="True" Margin="12,0" VerticalAlignment="Center" />
                                                <!-- 档位对应 RGB 颜色预览指示条 -->
                                                <Border Grid.Column="3" Width="32" Height="20" CornerRadius="4" Background="{Binding DisplayColor}" BorderBrush="#3E3E52" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- USB 回报率调节卡片 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,12" Margin="0,6,0,0" BorderBrush="#252536" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,220">
                                    <TextBlock Grid.Column="0" Text="USB 报告率 (Polling Rate):" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Grid.Column="1" Text="推荐竞技游戏设为 1000 Hz" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="12" Foreground="#8E8EA0" />
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding PollingRateOptions}" SelectedIndex="{Binding SelectedPollingRateIndex}" HorizontalAlignment="Stretch" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== RGB 幻彩灯光页面 ==================== -->
                    <ScrollViewer IsVisible="{Binding IsRgbTabActive}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="4,4,4,4">
                            <!-- 实时色彩光效与下发状态预览卡片 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,14" BorderBrush="#252536" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8" Margin="0,0,16,0"
                                            Background="{Binding CurrentHexColor}"
                                            BorderBrush="#40FFFFFF" BorderThickness="1"
                                            BoxShadow="0 0 16 2 #60A855F7" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="当前调配色彩:" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                            <TextBlock Text="{Binding CurrentHexColor}" Classes="mono" FontWeight="Bold" FontSize="14" Foreground="#00F5A0" />
                                        </StackPanel>
                                        <TextBlock Text="调节下方滑块或选择预设，色彩毫秒级实时联动并自动同步至鼠标" FontSize="11" Foreground="#8E8EA0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="sub-action" Content="⚡ 手动立即写入" Command="{Binding ApplyLightingCommand}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- 灯效模式与动态速度卡片 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,14" BorderBrush="#252536" BorderThickness="1">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="灯效模式与速度控制" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                    <Grid ColumnDefinitions="Auto,*,Auto,160" RowDefinitions="Auto">
                                        <TextBlock Grid.Column="0" Text="灯效模式:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding LightingModeOptions}" SelectedIndex="{Binding SelectedLightingModeIndex}" HorizontalAlignment="Stretch" Margin="0,0,24,0" />

                                        <TextBlock Grid.Column="2" Text="动态速度:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" />
                                        <Slider Grid.Column="3" Minimum="1" Maximum="3" Value="{Binding LightingSpeed}" IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 快捷预设色彩卡片 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,14" BorderBrush="#252536" BorderThickness="1">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="极客经典预设色 (点击即刻生效)" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                    <WrapPanel Margin="0,4">
                                        <Button Background="#FF1744" Content="热烈红" Width="72" Height="34" Margin="4" CornerRadius="6" FontWeight="Bold" Command="{Binding SetColorPresetCommand}" CommandParameter="FF0000" />
                                        <Button Background="#00E676" Content="极客绿" Width="72" Height="34" Margin="4" CornerRadius="6" FontWeight="Bold" Foreground="#000000" Command="{Binding SetColorPresetCommand}" CommandParameter="00FF00" />
                                        <Button Background="#2979FF" Content="深邃蓝" Width="72" Height="34" Margin="4" CornerRadius="6" FontWeight="Bold" Command="{Binding SetColorPresetCommand}" CommandParameter="0000FF" />
                                        <Button Background="#FFEA00" Content="活力黄" Width="72" Height="34" Margin="4" CornerRadius="6" FontWeight="Bold" Foreground="#000000" Command="{Binding SetColorPresetCommand}" CommandParameter="FFFF00" />
                                        <Button Background="#00E5FF" Content="赛博青" Width="72" Height="34" Margin="4" CornerRadius="6" FontWeight="Bold" Foreground="#000000" Command="{Binding SetColorPresetCommand}" CommandParameter="00FFFF" />
                                        <Button Background="#D500F9" Content="幻影紫" Width="72" Height="34" Margin="4" CornerRadius="6" FontWeight="Bold" Command="{Binding SetColorPresetCommand}" CommandParameter="FF00FF" />
                                        <Button Background="#FF6D00" Content="烈焰橙" Width="72" Height="34" Margin="4" CornerRadius="6" FontWeight="Bold" Command="{Binding SetColorPresetCommand}" CommandParameter="FF4500" />
                                        <Button Background="#FFFFFF" Content="纯净白" Width="72" Height="34" Margin="4" CornerRadius="6" FontWeight="Bold" Foreground="#000000" Command="{Binding SetColorPresetCommand}" CommandParameter="FFFFFF" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <!-- 自定义 RGB 独立色彩分量卡片 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,14" BorderBrush="#252536" BorderThickness="1">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="自定义 RGB 三原色微调" FontWeight="Bold" FontSize="14" Foreground="#FFFFFF" />
                                    <Grid ColumnDefinitions="36,*,50" RowDefinitions="Auto,Auto,Auto" Margin="0,4">
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="R" Foreground="#FF4D6D" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" />
                                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding SelectedRed}" Margin="10,0" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding SelectedRed}" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#FF4D6D" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="G" Foreground="#00F5A0" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" />
                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding SelectedGreen}" Margin="10,0" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding SelectedGreen}" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#00F5A0" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B" Foreground="#4D96FF" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" />
                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding SelectedBlue}" Margin="10,0" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SelectedBlue}" Classes="mono" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="14" Foreground="#4D96FF" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 硬件校准与即时测试 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,12" BorderBrush="#252536" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                                        <CheckBox IsChecked="{Binding SwapGreenAndBlue}" Content="启用硬件 RBG 物理通道反转适配" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="已实测校准：达尔优 LM113 硬件 PCB 的绿与蓝通道物理互换" FontSize="11" Foreground="#8E8EA0" Margin="28,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="sub-action" Content="仅测试此灯效" Command="{Binding ApplyLightingCommand}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ==================== 系统与跨平台说明 ==================== -->
                    <ScrollViewer IsVisible="{Binding IsAboutTabActive}" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="16" Margin="4,4,4,4">
                            <!-- 跨平台架构说明 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,14" BorderBrush="#252536" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="纯 C# 原生跨平台驱动架构" FontWeight="Bold" FontSize="14" Foreground="#7B61FF" />
                                    <TextBlock Text="本驱动采用纯 C# .NET 10 + HidSharp 协议引擎深度重构，彻底移除了对 Windows 原版专有闭源 DLL 的依赖，无缝支持 Windows、Linux 及 macOS 系统。" TextWrapping="Wrap" FontSize="12" Foreground="#C0C0D0" />
                                    <TextBlock Text="完整逆向荣腾科技（RoNgtEng）通信协议混淆算法，实现 9 字节 Feature Report 硬件级直控。" TextWrapping="Wrap" FontSize="12" Foreground="#8E8EA0" />
                                </StackPanel>
                            </Border>

                            <!-- Linux udev 权限配置提示 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,14" BorderBrush="#252536" BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="🐧 Linux 系统免 Root 使用提示 (udev 规则)" FontWeight="Bold" FontSize="14" Foreground="#00F5A0" />
                                    <TextBlock Text="Linux 系统默认普通用户无权读写原始 HID 节点。安装 deb/rpm 包已自动配置；如使用绿色便携包，可执行以下命令：" TextWrapping="Wrap" FontSize="12" Foreground="#C0C0D0" />
                                    <TextBox Text="echo 'SUBSYSTEM==&quot;hidraw&quot;, ATTRS{idVendor}==&quot;260d&quot;, MODE=&quot;0666&quot;' | sudo tee /etc/udev/rules.d/99-dareu.rules &amp;&amp; sudo udevadm control --reload" IsReadOnly="True" Classes="mono" FontSize="11" Margin="0,4" />
                                </StackPanel>
                            </Border>

                            <!-- 关于与版权 -->
                            <Border Background="#161620" CornerRadius="8" Padding="16,14" BorderBrush="#252536" BorderThickness="1">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="4">
                                        <TextBlock Text="DAREU LM113 Mouse Driver Client" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                                        <TextBlock Text="版本: v0.2.0-beta.5  |  开源许可证: MIT License" Classes="mono" FontSize="11" Foreground="#8E8EA0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="Crafted with ❤️ by VincentZyu &amp; Gemini" FontSize="12" Foreground="#7B61FF" VerticalAlignment="Center" FontWeight="SemiBold" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!-- 底部状态栏与保存下发 -->
        <Border Grid.Row="2" Background="#181822" Padding="20,12" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="状态:" FontSize="12" Foreground="#8E8EA0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#C0C0D8" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary-action" Content="应用并保存到鼠标" Command="{Binding ApplyAllCommand}" />
            </Grid>
        </Border>
    </Grid>
</Window>
